{
  "name": "rules-engine-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @rules-engine-kit/web dev",
    "engine": "tsx packages/engine/cli.ts",
    "lint": "biome check .",
    "content:lint": "tsx packages/db/src/content/bin/content-lint.ts",
    "db:migrate": "pnpm --filter @rules-engine-kit/db db:migrate",
    "db:seed": "pnpm --filter @rules-engine-kit/db db:seed",
    "db:reset": "pnpm --filter @rules-engine-kit/db db:reset",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @rules-engine-kit/web exec playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm content:lint && pnpm test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.10.1",
    "lefthook": "^2.1.14",
    "tsx": "^4.21.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
